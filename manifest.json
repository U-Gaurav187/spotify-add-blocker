{
  "manifest_version": 3,
  "name": "Ad Silencer & Queue Controller for Spotify™",
  "version": "3.0.0",
  "description": "Silences ads and unlocks unlimited skips, seek scrubbing, custom queue ordering, and on-demand playback on Spotify Web.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spotify-queue-controller@ugaurav.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://*.spotify.com/*",
    "https://*.doubleclick.net/*",
    "https://*.googlesyndication.com/*",
    "https://*.googleadservices.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_hook.js"
      ],
      "matches": [
        "https://open.spotify.com/*"
      ]
    }
  ]
}
